# SQLite database file (relative to the prisma/ directory)
DATABASE_URL="file:./dev.db"

# Better Auth session signing secret. Generate one with:
#   openssl rand -base64 32
# Never commit the real value.
BETTER_AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Base URL of the app (used by Better Auth for origin checks)
BETTER_AUTH_URL="http://localhost:3000"
